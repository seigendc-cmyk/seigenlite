# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- Publish Portal (tools/publish-portal) — Digital Commerce's machine only ---
SUPABASE_URL=https://urbopdsubwawtybwrxjd.supabase.co
# Public (anon) key, as built into the apps (src/devicecheckin.js DC_ANON_KEY). Can't publish.
SUPABASE_ANON_KEY=
# Supabase -> Project Settings -> API -> service_role (secret). Bypasses RLS:
# the portal keeps it server-side; never paste it into a page or an app build.
SUPABASE_SERVICE_ROLE_KEY=
# Only used once: proves you run the portal when creating the first Admin (12+ characters).
# After that, staff sign in with their own username and password.
PORTAL_PASSPHRASE=
# Optional; the portal listens on 127.0.0.1 only.
PORTAL_PORT=8787

# --- Database (schema tests, migrations) ---
# Session pooler URI from Supabase -> Connect.
SUPABASE_DB_URL=

# --- Cloudflare Workers deploys ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
