{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "seiGEN Commerce Lite",
  "version": "1.9.1",
  "identifier": "com.seigendc.seigenlite",
  "build": {
    "frontendDist": "../dist-tauri",
    "beforeDevCommand": "node ../build.js --tauri",
    "beforeBuildCommand": "node ../build.js --tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "seiGEN Commerce Lite",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
